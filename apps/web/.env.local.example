# Copy this file to .env.local and fill in your values.
# Get Clerk keys from: https://dashboard.clerk.com → Your App → API Keys

# Clerk — authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk — webhook (register endpoint in Clerk Dashboard → Webhooks)
# Endpoint: https://yourdomain.com/api/webhooks/clerk
CLERK_WEBHOOK_SECRET=whsec_...

# Clerk — sign-in/sign-up page locations (used by Clerk internally)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# App origin — used server-side to build absolute media delivery URLs
# (mobile's Image component can't resolve a relative URL the way a browser
# can, so signed /api/media/... URLs are always built as absolute).
APP_URL=http://localhost:3000

# Database — Neon pooled connection string
# Get from: https://console.neon.tech → Your Project → Connection Details → Pooled connection
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Cloudinary — legacy media (kept for cleanup of pre-migration uploads only;
# new uploads go to S3 below)
# Get from: https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# AWS S3 — media storage (photos)
# Get from: AWS Console → S3 (create bucket, block all public access, enable
# CORS for PUT from your dev/prod origins) → IAM (create a user scoped to
# s3:PutObject/GetObject/DeleteObject on that bucket only, generate access keys)
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
S3_BUCKET_NAME=passe-media-dev

# Media URL signing — HMAC secret for signed /api/media/[...key] delivery URLs.
# Generate locally, do not reuse across environments: `openssl rand -hex 32`
MEDIA_URL_SIGNING_SECRET=...

# Stripe — billing (test mode keys from https://dashboard.stripe.com/test/apikeys)
# Webhook secret: `stripe listen --forward-to localhost:3000/api/webhooks/stripe` locally,
# or Dashboard → Developers → Webhooks in production
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe — monthly price IDs for the paid plans (Dashboard → Product catalogue)
STRIPE_PRICE_EXPLORER=price_...
STRIPE_PRICE_COLLECTOR=price_...

# RevenueCat — mobile In-App Purchase webhook, mirrors the Stripe webhook above but for
# Explorer/Collector purchases made via the App Store/Play Store on apps/mobile.
# Shared secret configured in RevenueCat → Project Settings → Integrations → Webhooks
# (sent as an Authorization: Bearer header, not an HMAC signature like Stripe's).
REVENUECAT_WEBHOOK_SECRET=...

# Playwright e2e — dedicated test account on the dev Clerk instance above.
# `pnpm test:e2e`'s global setup creates this user (Clerk + DB row) on first run if missing.
E2E_CLERK_TEST_EMAIL=e2e+test@example.com
E2E_CLERK_TEST_PASSWORD=...

# Sentry — error tracking, performance tracing, session replay
# DSN from: https://sentry.io → passe-web project → Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://...@o...ingest.sentry.io/...
# Auth token for source map upload at build time: https://sentry.io → Settings → Auth Tokens
SENTRY_AUTH_TOKEN=sntrys_...
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=passe-web
