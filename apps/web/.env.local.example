# Copy this file to .env.local and fill in your values.
# Get Clerk keys from: https://dashboard.clerk.com → Your App → API Keys

# Clerk — authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk — webhook (register endpoint in Clerk Dashboard → Webhooks)
# Endpoint: https://yourdomain.com/api/webhooks/clerk
CLERK_WEBHOOK_SECRET=whsec_...

# Clerk — redirect URLs (must match @passe/auth/constants)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Database — Neon pooled connection string
# Get from: https://console.neon.tech → Your Project → Connection Details → Pooled connection
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
