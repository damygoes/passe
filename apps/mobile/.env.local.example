# Copy this file to .env.local and fill in your values.
# Get Clerk keys from: https://dashboard.clerk.com → Your App → API Keys
# Use the SAME Clerk application as apps/web (same publishable key value,
# just under this EXPO_PUBLIC_ name) — user sync via the Clerk webhook is
# scoped to the Clerk application, not the client.

# Clerk — authentication
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Passé web API — all data fetching proxies through apps/web's API routes
# Use your machine's LAN IP instead of localhost when testing on a physical device.
EXPO_PUBLIC_API_URL=http://localhost:3000

# MapTiler — vector basemap tiles for the map screen (same key/style as apps/web).
# Get one at https://cloud.maptiler.com (free tier).
EXPO_PUBLIC_MAPTILER_KEY=...

# Sentry — crash reporting and performance tracing
# DSN from: https://sentry.io → passe-mobile project → Settings → Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=https://...@o...ingest.sentry.io/...

# RevenueCat — Apple/Google In-App Purchase for Explorer/Collector plans
# Public SDK keys from: https://app.revenuecat.com → your project → API Keys
# (separate key per store app within the same RevenueCat project)
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=appl_...
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=goog_...
