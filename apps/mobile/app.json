{
  "expo": {
    "name": "passe",
    "slug": "passe-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "passe",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "cc.passe",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ]
      }
    },
    "android": {
      "package": "cc.passe",
      "adaptiveIcon": {
        "backgroundColor": "#2C1A0E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/PlayfairDisplay-Regular.ttf",
              "./assets/fonts/PlayfairDisplay-Bold.ttf",
              "./assets/fonts/Lora-Regular.ttf",
              "./assets/fonts/Lora-Italic.ttf",
              "./assets/fonts/Lora-SemiBold.ttf",
              "./assets/fonts/DMMono-Regular.ttf",
              "./assets/fonts/Caveat-Regular.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Playfair Display",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/PlayfairDisplay-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/PlayfairDisplay-Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "Lora",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Lora-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Lora-Italic.ttf",
                    "weight": 400,
                    "style": "italic"
                  },
                  {
                    "path": "./assets/fonts/Lora-SemiBold.ttf",
                    "weight": 600
                  }
                ]
              },
              {
                "fontFamily": "DM Mono",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/DMMono-Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Caveat",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Caveat-Regular.ttf",
                    "weight": 400
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF6EE",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-localization",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Passé needs access to your photo library so you can add photos to your trips and memories.",
          "cameraPermission": "Passé needs camera access so you can capture new memories."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Passé uses your location to tag memories with the place they were captured."
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0",
            "usePrecompiledModules": false
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "damilola-bada",
          "project": "passe-mobile"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6ebd083d-bc62-4f43-9599-8a90c1d6afdd"
      }
    },
    "owner": "damygoes",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6ebd083d-bc62-4f43-9599-8a90c1d6afdd"
    }
  }
}
