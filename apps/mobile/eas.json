{
  "cli": {
    "version": ">= 16.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY": "TODO_pk_live_...",
        "EXPO_PUBLIC_API_URL": "https://TODO-production-domain.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "TODO_AFTER_ASC_APP_CREATED"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
