    "outDir": "dist",
    "strictNullChecks": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "src/utils", "../utils/src/cn.ts"],
  "exclude": ["node_modules", "dist"]
}
