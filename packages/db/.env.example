# Copy this file to .env and fill in your Neon pooled connection strings.

# Development database — used by the everyday drizzle-kit commands
# (db:generate, db:migrate, db:push, db:studio). Must match the
# DATABASE_URL in apps/web/.env.local so migrations hit the DB the app uses.
DATABASE_URL=postgres://user:password@dev-host/dbname?sslmode=require

# Production database — used ONLY by db:migrate:prod / db:studio:prod.
# In CI this comes from the PROD_DATABASE_URL repository secret.
DATABASE_URL_PROD=postgres://user:password@prod-host/dbname?sslmode=require
