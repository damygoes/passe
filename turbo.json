{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV", "CI", "NEXT_RUNTIME"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": [
        "NEXT_PUBLIC_*",
        "CLERK_*",
        "CLOUDINARY_*",
        "STRIPE_*",
        "REVENUECAT_*",
        "DATABASE_URL",
        "EXPO_PUBLIC_*",
        "VERCEL_ENV",
        "SENTRY_*",
        "APP_URL",
        "AWS_*",
        "S3_BUCKET_NAME",
        "MEDIA_URL_SIGNING_SECRET"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": true
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*", "CLERK_*", "DATABASE_URL", "E2E_CLERK_TEST_*"],
      "outputs": ["playwright-report/**"],
      "cache": false
    }
  }
}
